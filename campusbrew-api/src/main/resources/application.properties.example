spring.application.name=campusbrew-api

# Server
server.port=8080

# MongoDB (Atlas - shared team database)
# Replace with your team's actual Atlas URI in application.properties (gitignored)
spring.data.mongodb.uri=mongodb+srv://<atlas-user>:<atlas-password>@<cluster-host>/?appName=CampusBrew
spring.data.mongodb.database=campusbrew

# JWT
# Generate a strong random string (e.g. `openssl rand -base64 48`) for your local application.properties
jwt.secret=<generate-a-long-random-secret>
jwt.expiration=86400000

# Email (OTP sending)
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=<your-gmail-address>
spring.mail.password=<your-gmail-app-password>
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# CORS
cors.allowed-origins=http://localhost:3000,http://localhost:8081

# Socket.IO (Module 3 real-time delivery dispatch + tracking)
socketio.host=0.0.0.0
socketio.port=9092

# Delivery assignment defaults (Module 3 Wave C)
delivery.campus.longitude=123.881
delivery.campus.latitude=10.2945
delivery.dispatch.timeoutSeconds=60
delivery.dispatch.searchRadiusKm=5
delivery.orderExpiry.minutes=10

# Disable Spring Security's default login page for now
spring.security.user.name=admin
spring.security.user.password=admin
