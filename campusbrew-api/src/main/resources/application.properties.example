spring.application.name=campusbrew-api

# Server
server.port=8080

# MongoDB (Atlas - shared team database)
# Replace with your team's actual Atlas URI in application.properties (gitignored)
spring.data.mongodb.uri=mongodb+srv://<atlas-user>:<atlas-password>@<cluster-host>/?appName=CampusBrew
spring.data.mongodb.database=campusbrew

# JWT
# Generate a strong random string (e.g. `openssl rand -base64 48`) for your local application.properties
jwt.secret=<generate-a-long-random-secret>
jwt.expiration=86400000

# Email (OTP sending)
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=<your-gmail-address>
spring.mail.password=<your-gmail-app-password>
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# CORS

# Delivery assignment defaults (Module 3 Wave C)
delivery.campus.longitude=123.881
delivery.campus.latitude=10.2945
delivery.orderExpiry.minutes=10

# Disable Spring Security's default login page for now
spring.security.user.name=admin
spring.security.user.password=admin

# ================= v2.0 (SRS/SDD v2.0) =================
fees.deliveryFee=15
fees.commission=5
incentive.threshold=5
cod.limit=300
delivery.offer.rebroadcastSeconds=60
tip.maxAmount=100
tip.windowHours=24
rating.windowHours=24
rating.minCountToShow=3
chat.readOnlyAfterMinutes=30
# Xendit — set these in your real application.properties / environment only.
xendit.secretKey=<xendit-test-secret-key>
xendit.callbackToken=<xendit-webhook-callback-token>
xendit.successUrl=campusbrew://payment/success
xendit.failureUrl=campusbrew://payment/failure

# Default admin account (created on startup if missing)
admin.email=admin@campusbrew.app
admin.password=change-me

# Optional: send code emails through Brevo's HTTPS API instead of Gmail SMTP
# (needed on Render's free plan, which blocks SMTP ports). Leave blank to use spring.mail.*.
brevo.apiKey=
mail.from=<sender-verified-in-brevo>
